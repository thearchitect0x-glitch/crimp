# Crimp — local development defaults. Copy to .env; these work as-is.
DATABASE_URL=postgres://crimp:crimp@localhost:5434/crimp

# Protects API keys. Production refuses to start on the dev default or under 32 chars.
AUTH_SECRET=dev-secret-do-not-use-in-production

# Peppers subject aliases. MUST differ from AUTH_SECRET in production:
# a blinded alias cannot be re-derived, so rotating this does not rotate a key,
# it orphans every subject in the system.
BLIND_SECRET=dev-secret-do-not-use-in-production

PORT=8788
# CORS_ORIGINS=https://console.example.com
